<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springcrazy.modules.clazz.mapper.ClassroomMapper">
    <select id="getList" resultType="org.springcrazy.modules.clazz.pojo.ClassroomVO">
        select t1.*
        from classroom t1
        <where>
            <if test="param.name != null and param.name != ''">
                AND t1.name like concat('%', #{param.name}, '%')
            </if>
            AND t1.deleted != 1
        </where>
    </select>
</mapper>
